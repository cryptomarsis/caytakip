{
  "expo": {
    "name": "Çaylık",
    "slug": "cay-ureticisi",
    "description": "Çaylık; çay üreticileri için sade hasat, ödeme, gider ve fabrika fiyatı takibi.",
    "scheme": "cayureticisi",
    "version": "1.0.4",
    "orientation": "portrait",
    "backgroundColor": "#F8F3E7",
    "icon": "./assets/caylik-icon-v1.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cryptomarsis.cayureticisi",
      "versionCode": 4,
      "backgroundColor": "#F8F3E7",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/caylik-icon-v1.png",
        "backgroundColor": "#002A17"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F3E7"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "988521d0-c07b-466f-ad90-05cb3be4e358"
      }
    },
    "owner": "cryptomarsis"
  }
}
