# API
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Security: generate a long, unique random value for each secret.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_SECRET=replace-with-a-separate-long-random-secret
ADMIN_PHONE=05XXXXXXXXX
# Web sürümü kullanılacaksa virgülle ayırarak izin verilen web adreslerini yazın.
ALLOWED_ORIGINS=https://your-web-domain.example

# Expo push notifications (optional; required for remote push registration)
EXPO_PUBLIC_PROJECT_ID=your-eas-project-id

# Yapay zekâ (yalnızca sunucuda/Render ortam değişkenlerinde tutulur; mobil uygulamaya eklemeyin)
OPENAI_API_KEY=your-openai-api-key
# İsteğe bağlı: maliyet/hız dengesi için varsayılan model
OPENAI_MODEL=gpt-5-mini
