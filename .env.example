# API
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Security: generate a long, unique random value for each secret (minimum 32 characters).
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
OTP_SECRET=replace-with-a-separate-long-random-secret
ADMIN_PHONE=05XXXXXXXXX
SUPPORT_EMAIL=destek@example.com
APP_NAME=Cay Ureticisi
# Web sürümü kullanılacaksa virgülle ayırarak izin verilen web adreslerini yazın.
ALLOWED_ORIGINS=https://your-web-domain.example

# SMS login (NetGSM). Keep AUTH_REQUIRE_OTP=false while testing.
# Before public launch, create a NetGSM API sub-user, request an OTP package and a sender header,
# then set AUTH_REQUIRE_OTP=true in Render.
AUTH_REQUIRE_OTP=false
NETGSM_USERCODE=850XXXXXXX
NETGSM_PASSWORD=netgsm-api-sub-user-password
NETGSM_HEADER=CAYTAKIP

# Optional external encrypted backup. Point this to a serverless/webhook endpoint you control.
# Render local storage is not a production backup destination.
BACKUP_WEBHOOK_URL=https://your-backup-endpoint.example/backups
BACKUP_ENCRYPTION_KEY=replace-with-a-third-long-random-secret
