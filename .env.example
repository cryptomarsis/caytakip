# API
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Security: generate a long, unique random value for each secret (minimum 32 characters).
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
OTP_SECRET=replace-with-a-separate-long-random-secret
ADMIN_PHONE=05XXXXXXXXX
SUPPORT_EMAIL=destek@example.com
APP_NAME=Çaylık
# Web sürümü kullanılacaksa virgülle ayırarak izin verilen web adreslerini yazın.
ALLOWED_ORIGINS=https://your-web-domain.example

# SMS login (NetGSM). Keep AUTH_REQUIRE_OTP=false while testing.
# Before public launch, create a NetGSM API sub-user, request an OTP package and a sender header,
# then set AUTH_REQUIRE_OTP=true in Render.
AUTH_REQUIRE_OTP=false
# One-time recovery for an account created before PIN login existed.
# Set PIN_MIGRATION_PHONE to that account's phone; do not share it publicly.
# Set true only while the user creates a PIN, then immediately set false again.
AUTH_ALLOW_PIN_MIGRATION=false
PIN_MIGRATION_PHONE=05XXXXXXXXX
NETGSM_USERCODE=850XXXXXXX
NETGSM_PASSWORD=netgsm-api-sub-user-password
NETGSM_HEADER=CAYTAKIP

# Optional external encrypted backup. Point this to a serverless/webhook endpoint you control.
# Render local storage is not a production backup destination.
BACKUP_WEBHOOK_URL=https://your-backup-endpoint.example/backups
BACKUP_ENCRYPTION_KEY=replace-with-a-third-long-random-secret

# OpenAI services. Keep the API key only on the server (Render), never in the mobile app.
OPENAI_API_KEY=sk-your-server-side-key
OPENAI_MODEL=gpt-5-mini
OPENAI_ASSISTANT_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
AI_INITIAL_CREDITS=50
# Credit calculation. Update these values when the selected model's API pricing changes.
AI_CREDIT_USD=0.00025
AI_INPUT_USD_PER_MILLION=0.25
AI_OUTPUT_USD_PER_MILLION=2
AI_MAX_RESERVED_CREDITS=25

# Apple App Store Server API. Use an In-App Purchase key from
# App Store Connect > Users and Access > Integrations > In-App Purchase.
# Keep the .p8 key only in Render. For a single-line environment value, replace
# real line breaks with the two characters \n.
APPLE_IAP_BUNDLE_ID=com.cryptomarsis.cayureticisi
APPLE_IAP_ISSUER_ID=your-in-app-purchase-issuer-id
APPLE_IAP_KEY_ID=your-in-app-purchase-key-id
APPLE_IAP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----

# RevenueCat webhook authentication. Use the same random value in RevenueCat
# Webhooks > Authorization and Render environment variables.
REVENUECAT_WEBHOOK_AUTH=replace-with-a-long-random-webhook-secret
